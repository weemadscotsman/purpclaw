# ═══════════════════════════════════════════════════════════════════
#  PURPCLAW — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your keys.
#  Only the provider you're using needs a key — the rest can stay blank.
#  Ollama and LM Studio are fully local and need no API key.
# ═══════════════════════════════════════════════════════════════════

# ── Primary LLM provider ──────────────────────────────────────────
# Which provider to use for orchestration, planning, and the `ask` command.
# Options: openai, anthropic, gemini, kimi, minimax, groq, deepseek,
#          nvidia, openrouter, together, mistral, ollama, lmstudio, github-models,
#          codex, codex-oauth, atomic-chat, custom
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=                    # set if your provider needs one
# LLM_BASE_URL=                   # override the default endpoint

# ── Local fallback ────────────────────────────────────────────────
# When the primary provider fails, fall back to a local model.
# Options: ollama, lmstudio, off
LLM_FALLBACK=ollama
LLM_FALLBACK_MODEL=qwen2.5:3b
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1

# ── Swarm provider (heavy reasoning) ─────────────────────────────
# Optional separate provider for the swarm engine (parallel agents).
# Falls back to the primary LLM_ config if not set.
# SWARM_PROVIDER=kimi
# SWARM_API_KEY=
# SWARM_MODEL=kimi-k2-5

# ── Provider-specific API keys ────────────────────────────────────
# Set the key for whichever provider(s) you use.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# KIMI_API_KEY=                   # https://platform.moonshot.cn
# MINIMAX_API_KEY=
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=nvapi-...         # Free tier: https://build.nvidia.com/models
# GITHUB_TOKEN=ghp_...            # GitHub Models (free tier, needs models:read scope)
# CODEX_OAUTH_TOKEN=               # from `codex login` device flow
# ATOMIC_CHAT_API_KEY=
# ATOMIC_CHAT_BASE_URL=https://api.atomic-chat.example/v1

# ── Service ports (defaults shown) ────────────────────────────────
# Override any port if you have conflicts.
# API_PORT=7780
# TOWER_PORT=7790
# EVENTBUS_PORT=7782
# STATE_PORT=7783
# ORCHESTRATOR_PORT=7784
# MEMORY_PORT=7880
# POOL_PORT=7885
# METRICS_PORT=7890
# VOICE_PORT=7781
# CONTEXT_PORT=7881

# ── Optional integrations ────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=              # Telegram gateway
# DISCORD_BOT_TOKEN=               # Discord gateway
# SLACK_BOT_TOKEN=                 # Slack gateway

# ── Debug ─────────────────────────────────────────────────────────
# PURPCLAW_LLM_DEBUG=1             # verbose LLM request logging
# PURPCLAW_TAINT=1                 # enable taint mode (chaotic UI text)
# PURPCLAW_PROACTIVE=1             # enable proactive reasoning loop
