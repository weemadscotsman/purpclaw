# Xiaozhi MCP WebSocket URL (get this from xiaozhi.me/console → MCP Settings)
XIAOZHI_MCP_URL=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN_HERE

# OpenClaw WebSocket Gateway (optional, for OpenClaw integration)
OPENCLAW_GATEWAY=ws://127.0.0.1:18789

# MCP Bridge HTTP Server URL  
MCP_BRIDGE_URL=http://localhost:3001
