# ════════════════════════════════════════════════════════════════════════════
#  PURPCLAW — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your keys.
#  Only the provider you're using needs a key — the rest can stay blank.
#  Ollama and LM Studio are fully local and need no API key.
#
#  Cactus 2026-06-22: full lane/port/swarm/research template — every var
#  .env actually uses is documented here so devs don't leak live keys.
# ════════════════════════════════════════════════════════════════════════════

# ── Primary LLM provider ─────────────────────────────────────────────────────
# Which provider to use for orchestration, planning, and the `ask` command.
# Options: openai, anthropic, gemini, kimi, glm, minimax, groq, deepseek,
#          nvidia, huggingface, cloudflare, cohere, openrouter, together,
#          mistral, ollama, lmstudio, github-models, codex, codex-oauth,
#          atomic-chat, custom
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=                    # set if your provider needs one
# LLM_BASE_URL=                   # override the default endpoint

# ── Local fallback ───────────────────────────────────────────────────────────
# When the primary provider fails, fall back to a local model.
# Options: ollama, lmstudio, off
LLM_FALLBACK=ollama
LLM_FALLBACK_MODEL=qwen2.5:3b
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1

# ── Swarm provider (heavy reasoning) ─────────────────────────────────────────
# Optional separate provider for the swarm engine (parallel agents).
# Falls back to the primary LLM_ config if not set.
# SWARM_PROVIDER=kimi
# SWARM_API_KEY=
# SWARM_MODEL=kimi-k2-6

# ── Provider API keys (set the one(s) you use) ──────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# KIMI_API_KEY=                   # https://platform.moonshot.cn
# GLM_API_KEY=                    # https://z.ai/manage-apikey (GLM Coding Plan)
# GLM_MODEL=glm-4.6               # GLM-4.6 default
# MINIMAX_API_KEY=
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# MISTRAL_API_KEY=***
# NVIDIA_API_KEY=nvapi-...         # Free tier: https://build.nvidia.com/models
#
# ── NIM 5-lane key pool (5 primary + 5 backup) ──────────────────────────────
# Each lane has a primary + backup. On 429, backup kicks in for 60s.
# On 3x 401, the key is marked dead for the rest of the session.
#   ai_and_machine_learning → PURP1/BACKUP1 (default provider lane)
#   accelerated_computing   → PURP2/BACKUP2 (eval/benchmark traffic)
#   developer_tools         → PURP3/BACKUP3 (engineering/code review)
#   swarm                   → PURP4/BACKUP4 (parallel agent bursts)
#   planning_quick          → PURP5/BACKUP5 (DeepSeek Pro/Flash planner)
# NVIDIA_API_KEY_PURP1=nvapi-...
# NVIDIA_API_KEY_BACKUP1=nvapi-...
# NVIDIA_API_KEY_PURP2=nvapi-...
# NVIDIA_API_KEY_BACKUP2=nvapi-...
# NVIDIA_API_KEY_PURP3=nvapi-...
# NVIDIA_API_KEY_BACKUP3=nvapi-...
# NVIDIA_API_KEY_PURP4=nvapi-...
# NVIDIA_API_KEY_BACKUP4=nvapi-...
# NVIDIA_API_KEY_PURP5=nvapi-...
# NVIDIA_API_KEY_BACKUP5=nvapi-...
# NVIDIA_API_KEY_HERMES=nvapi-...   # last-resort fallback
# HUGGINGFACE_API_KEY=hf-...      # Free: https://huggingface.co/settings/tokens
# CF_API_TOKEN=                   # Cloudflare Workers AI free: 10k neurons/day
# COHERE_API_KEY=                 # Cohere trial credits
# GITHUB_TOKEN=                   # GitHub Models (free tier)
# CODEX_OAUTH_TOKEN=               # from `codex login` device flow
# ATOMIC_CHAT_API_KEY=
# ATOMIC_CHAT_BASE_URL=https://api.atomic-chat.example/v1

# ── Service ports (defaults shown) ───────────────────────────────────────────
# Override any port if you have conflicts.
# API_PORT=7780
# TOWER_PORT=7790
# EVENTBUS_PORT=7782
# STATE_PORT=7783
# ORCHESTRATOR_PORT=7784
# MEMORY_PORT=7880
# POOL_PORT=7885
# METRICS_PORT=7890
# VOICE_PORT=7781
# CONTEXT_PORT=7881

# ── Internal cross-service ──────────────────────────────────────────────────
# These are for service-to-service auth, NOT for the operator.
# PURPCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# INTERNAL_API_KEY=                # long random hex; rotates via ops
# MCP_BRIDGE_URL=http://localhost:3001
# XIAOZHI_MCP_URL=wss://api.xiaozhi.me/mcp/?token=...
# XIAOZHI_WS_URL=wss://api.xiaozhi.me/mcp/?token=...

# ── Rate limits ─────────────────────────────────────────────────────────────
# PURPCLAW_RATE_LIMIT=1
# PURPCLAW_RATE_LIMIT_WINDOW_MS=60000
# PURPCLAW_RATE_LIMIT_READ=240
# PURPCLAW_RATE_LIMIT_WRITE=60
# PURPCLAW_RATE_LIMIT_STREAM=30

# ── Deep Research Group — rate limiter (cost guard) ────────────────────────
# PURPCLAW_RESEARCH_CONCURRENCY=2
# PURPCLAW_RESEARCH_MIN_DELAY_MS=1500
# PURPCLAW_RESEARCH_PER_PROVIDER=1
# PURPCLAW_RESEARCH_CALL_TIMEOUT_MS=90000
# PURPCLAW_RESEARCH_COST_CAP_USD=5.0

# ── Operator flags ─────────────────────────────────────────────────────────
# EVOLUTION_DISABLED=0             # 1 to disable self-evolution loop
# POCKET_MODE=hybrid               # off | local | hybrid | cloud
# PURPCLAW_MOCHI_SEED=1
# PURPCLAW_SHOW_THINK=1            # expose thinking blocks in chat
# PURPCLAW_PROACTIVE=1             # enable proactive reasoning loop
# PURPCLAW_MISSION_SANDBOX=0       # 1 to re-enable git-worktree isolation

# ── Optional integrations ───────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=              # Telegram gateway (single bot)
# TELEGRAM_BOT_TOKEN_DG=           # multi-persona bot tokens (optional)
# TELEGRAM_BOT_TOKEN_WF=
# TELEGRAM_BOT_TOKEN_DK=
# TELEGRAM_BOT_TOKEN_GH=
# TELEGRAM_PERSONA_DG=dragon
# TELEGRAM_PERSONA_WF=wolf
# TELEGRAM_PERSONA_DK=duck
# TELEGRAM_PERSONA_GH=ghost
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# ── Debug ──────────────────────────────────────────────────────────────────
# PURPCLAW_LLM_DEBUG=1             # verbose LLM request logging
# PURPCLAW_TAINT=1                 # enable taint mode (chaotic UI text)
