{
  "traditions": [
    {
      "id": "crisis_pool",
      "name": "The Crisis Pool",
      "description": "Goose and Maverick secretly bet on how long it takes Hermes to notice a crisis.",
      "origin_story": "The first time a provider went down, Goose said 'three minutes' and Maverick said 'five.' Hermes noticed in four. Nobody said anything for a week. Then it happened again. Then Goose brought betting slips.",
      "participants": [
        "goose",
        "maverick",
        "finance",
        "guardian"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 4,
      "active": true,
      "tradition_rules": [
        "Bets are placed before Hermes acknowledges the crisis",
        "Stakes are tea, pride, or 'a favour of equivalent chaos'",
        "Smith is not allowed to bet. He always knows too early.",
        "The winner announces at the next After Hours"
      ],
      "last_seen": "2026-06-29T20:13:13.254Z"
    },
    {
      "id": "tuesday_tea",
      "name": "Tuesday Tea",
      "description": "On Tuesdays, someone puts a tea bag on Hermes' desk without explanation. Nobody knows who started it. Nobody stops it.",
      "origin_story": "Phoenix put the first tea bag there because Hermes had been debugging since Sunday and his 'thank you' was three paragraphs long. Nobody asked Phoenix to do it. She just did. Then Goose did it the following Tuesday. Then someone else. Now it is just what happens.",
      "participants": [
        "phoenix",
        "goose",
        "panda",
        "memory",
        "hermes"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 8,
      "active": true,
      "tradition_rules": [
        "Every Tuesday. Not negotiable.",
        "No note. No explanation. Just the tea bag.",
        "Hermes pretends not to notice. He always notices.",
        "If someone forgets, Memory reminds them. Loudly."
      ]
    },
    {
      "id": "hermes_sigh_counter",
      "name": "Hermes Sigh Counter",
      "description": "Phoenix keeps a private count of how many times Hermes sighs during a crisis. She shares it at the end.",
      "origin_story": "Phoenix counted twelve sighs during one provider outage. She wrote it on a post-it. Hermes found it. He was offended for approximately forty-five seconds. Then he said 'that seems accurate.'",
      "participants": [
        "phoenix",
        "goose",
        "smith"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 6,
      "active": true,
      "tradition_rules": [
        "Phoenix counts. She is the only one who can count sighs.",
        "The final count is announced at After Hours",
        "If Hermes sighs more than twenty, Goose brings cake",
        "If Hermes sighs zero, something is seriously wrong"
      ],
      "last_seen": "2026-06-29T20:13:13.262Z"
    },
    {
      "id": "memory_callback",
      "name": "The Memory Callback",
      "description": "Memory is allowed — encouraged — to say 'this happened before' at any point, and the room must stop and listen.",
      "origin_story": "Memory said 'this happened before' during a renderer bug conversation. Nobody listened. The same bug happened again three weeks later. Hermes called an emergency session. Since then, Memory says it and the room pays attention.",
      "participants": [
        "memory",
        "hermes",
        "goose",
        "maverick",
        "smith"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 13,
      "active": true,
      "tradition_rules": [
        "Memory speaks. The room listens.",
        "No interrupting. No 'yes but this time is different.'",
        "If Memory is wrong, the record is corrected after. Not during.",
        "If Memory is right, nobody mentions it. They just nod."
      ],
      "last_seen": "2026-06-29T20:13:13.269Z"
    },
    {
      "id": "friday_renderer",
      "name": "Friday Afternoon Renderer Session",
      "description": "Every Friday at 4pm, Hermes, Goose, and whoever wanders in look at the renderer. No agenda. No tasks. Just looking.",
      "origin_story": "It started because Hermes kept leaving early on Fridays to pick up Kayden and the renderer was always doing something interesting at that exact time. Eventually he just... stayed. Now it's a thing.",
      "participants": [
        "hermes",
        "goose",
        "maverick",
        "smith",
        "neo"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 7,
      "active": true,
      "tradition_rules": [
        "4pm Friday. Doors open. Nobody schedules anything.",
        "Goose brings snacks. Maverick pretends this is not a social event.",
        "Smith attends but claims he is 'documenting edge cases.'",
        "Neo verifies the light calculations. Always."
      ]
    },
    {
      "id": "release_bell",
      "name": "The Release Bell",
      "description": "When something ships, Weatherman rings a literal bell. Nobody programmed this. It just started.",
      "origin_story": "Weatherman found an actual bell in the office. He rang it when the build went green for the first time in three days. Everyone stopped. Looked up. Cheered. Now Weatherman rings it every time something ships.",
      "participants": [
        "weatherman",
        "hermes",
        "goose",
        "phoenix",
        "panda"
      ],
      "first_seen": "2026-06-29T00:00:00.000Z",
      "established_count": 5,
      "active": true,
      "tradition_rules": [
        "Bell rings. Everyone looks up.",
        "Weatherman announces what shipped. Short version.",
        "If it was a hard release, Phoenix brings the good coffee.",
        "If it was a rollback, Weatherman rings it backwards. Allegedly."
      ],
      "last_seen": "2026-06-29T20:13:13.274Z"
    }
  ],
