# ════════════════════════════════════════════════════════════════════════════
#  🕳️ VOID — .dockerignore
#  ════════════════════════════════════════════════════════════════════════════
#  EXCLUDE EVERYTHING THAT COULD LEAK SECRETS, BUILD ARTIFACTS, OR NOISE INTO
#  THE IMAGE. The Docker build context is what `COPY . .` would otherwise grab.
# ════════════════════════════════════════════════════════════════════════════

# ── Secrets (NEVER bake into images — Distroless has no way to scrub them) ─
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
.tokens/

# ── VCS metadata ─────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── CI / dev tooling ─────────────────────────────────────────────────────────
.eslintrc*
.eslintignore
.prettierrc*
.editorconfig
.vscode
.idea
*.swp
*.swo

# ── Node / Next.js build outputs (rebuilt inside container) ──────────────────
node_modules
.npm
.yarn
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.next
.nuxt
dist
build
coverage
*.tsbuildinfo

# ── Test artifacts ───────────────────────────────────────────────────────────
tests
__tests__
test-patches
fixtures
*.test.*
*.spec.*
coverage
.nyc_output

# ── Documentation (don't ship to runtime) ────────────────────────────────────
*.md
!README.md
docs/
CHANGELOG.md
LICENSE

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs and runtime data ────────────────────────────────────────────────────
logs/
*.log
tmp/
temp/

# ── Agent runtime state (per-machine, never baked in) ───────────────────────
.omnicode/
.purpclaw/
.archive/
memory_archive*
.trip_logs/
.no-spaghett/
.STRESS/
_scratch/
_donors/
_FF.txt
_SW.txt
out.txt
hi.txt
build_*.txt

# ── Python (cognitive services run separately) ──────────────────────────────
__pycache__
*.pyc
*.pyo
.python-version
.venv
venv
env/

# ── Local datasets and uploads ───────────────────────────────────────────────
data/
public/uploads/
public/user-uploads/
