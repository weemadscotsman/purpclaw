/* PURPCLAW Console — Textual stylesheet */

Screen {
    background: #09090b;
    color: #e4e4e7;
    layers: base overlay;
}

#header {
    height: 3;
    background: #0d0d11;
    border-bottom: tall #1f1f23;
    padding: 0 2;
    content-align: center middle;
}

#brand {
    color: #67e8f9;
    text-style: bold;
}

#brand-dim {
    color: #e4e4e7;
    text-style: bold;
}

#version {
    color: #34d399;
    background: #052e1f;
    border: round #34d399;
    padding: 0 1;
    margin-left: 2;
}

#status-pill {
    dock: right;
    color: #67e8f9;
    background: #0e2a33;
    border: round #22d3ee;
    padding: 0 1;
    width: auto;
}

#footer {
    height: 1;
    background: #0d0d11;
    border-top: tall #1f1f23;
    color: #71717a;
    padding: 0 2;
}

#hero {
    height: auto;
    padding: 2 4 1 4;
    align: center middle;
    text-align: center;
}

#hero-title {
    color: #fafafa;
    text-style: bold;
    text-align: center;
    width: 100%;
}

#hero-grad {
    color: #67e8f9;
    text-style: bold;
    text-align: center;
    width: 100%;
}

#hero-sub {
    color: #a1a1aa;
    text-align: center;
    width: 100%;
    margin-top: 1;
}

#grid {
    padding: 1 2 1 2;
    height: auto;
    layout: grid;
    grid-size: 3;
    grid-gutter: 1 1;
    grid-columns: 1fr 1fr 1fr;
}

.tile {
    height: 9;
    border: tall #27272a;
    background: #0d0d11;
    padding: 1 2;
    transition: border 200ms;
}

.tile:hover {
    border: tall #3f3f46;
    background: #131318;
}

.tile-accent-cyan { border-left: tall #22d3ee; }
.tile-accent-violet { border-left: tall #a78bfa; }
.tile-accent-emerald { border-left: tall #34d399; }
.tile-accent-amber { border-left: tall #fbbf24; }
.tile-accent-sky { border-left: tall #38bdf8; }
.tile-accent-rose { border-left: tall #fb7185; }

.tile-head {
    height: 1;
    width: 100%;
}

.tile-num {
    color: #52525b;
    text-style: dim;
}

.tile-icon {
    width: 3;
    text-align: center;
}

.tile-accent-cyan .tile-icon { color: #22d3ee; text-style: bold; }
.tile-accent-violet .tile-icon { color: #a78bfa; text-style: bold; }
.tile-accent-emerald .tile-icon { color: #34d399; text-style: bold; }
.tile-accent-amber .tile-icon { color: #fbbf24; text-style: bold; }
.tile-accent-sky .tile-icon { color: #38bdf8; text-style: bold; }
.tile-accent-rose .tile-icon { color: #fb7185; text-style: bold; }

.tile-status {
    dock: right;
    width: auto;
    color: #34d399;
}

.tile-title {
    color: #fafafa;
    text-style: bold;
    width: 100%;
    height: 1;
    margin-top: 1;
}

.tile-blurb {
    color: #a1a1aa;
    width: 100%;
    height: 3;
    margin-top: 1;
}

.tile-footer {
    dock: bottom;
    height: 1;
    width: 100%;
    color: #52525b;
    text-style: dim;
}

/* Detail screen */

#detail {
    padding: 2 4;
    align: center top;
}

#detail-back {
    dock: top;
    height: 1;
    width: 100%;
    color: #71717a;
    margin-bottom: 1;
}

#detail-card {
    width: 90%;
    max-width: 100;
    height: auto;
    border: tall #1f1f23;
    background: #0d0d11;
    padding: 2 3;
}

#detail-head {
    height: 1;
    width: 100%;
}

#detail-num {
    color: #52525b;
    text-style: dim;
}

#detail-icon {
    color: #22d3ee;
    text-style: bold;
    width: 3;
    text-align: center;
}

#detail-title {
    color: #fafafa;
    text-style: bold;
    width: 100%;
    height: 1;
    margin-top: 1;
}

#detail-blurb {
    color: #a1a1aa;
    text-style: italic;
    width: 100%;
    margin-top: 1;
}

#detail-divider {
    height: 1;
    width: 100%;
    margin-top: 1;
    color: #27272a;
}

#detail-body {
    color: #d4d4d8;
    width: 100%;
    height: auto;
    margin-top: 1;
}

#detail-channels-label {
    color: #71717a;
    text-style: bold;
    width: 100%;
    margin-top: 2;
}

#detail-channels {
    height: auto;
    width: auto;
    margin-top: 1;
}

.channel-chip {
    height: 3;
    width: auto;
    padding: 0 2;
    margin-right: 1;
    border: tall #22d3ee;
    color: #22d3ee;
    background: #0e2a33;
    text-style: bold;
    content-align: center middle;
}

#detail-actions {
    height: 3;
    width: auto;
    margin-top: 2;
    align: left middle;
}

.action-btn {
    height: 3;
    width: auto;
    min-width: 16;
    margin-right: 1;
    border: tall #22d3ee;
    background: #0e2a33;
    color: #67e8f9;
    text-style: bold;
    content-align: center middle;
    padding: 0 2;
}

.action-btn:hover {
    background: #164e63;
    color: #fafafa;
}

.action-btn-secondary {
    height: 3;
    width: auto;
    min-width: 14;
    margin-right: 1;
    border: tall #3f3f46;
    background: #18181b;
    color: #a1a1aa;
    text-style: bold;
    content-align: center middle;
    padding: 0 2;
}

.action-btn-secondary:hover {
    border: tall #52525b;
    color: #fafafa;
}

#command-bar {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #0d0d11;
    color: #71717a;
    padding: 0 2;
}

.kbd {
    color: #67e8f9;
    text-style: bold;
}

#scanline {
    layer: overlay;
    width: 100%;
    height: 1;
    background: #22d3ee 20%;
}
