# ============================================================
# VOID // .env.example
# Copy to .env and fill. The void respects your secrets.
# ============================================================

# ---- Runtime ----
VOID_ENV=production
VOID_BUILD=manual

# ---- Networking ----
VOID_WEB_PORT=8080
VOID_WEB_REPLICAS=1

# ---- API (only used with `docker compose --profile full`) ----
VOID_API_PORT=3000
VOID_API_TOKEN=
VOID_API_RATE_LIMIT=60

# ---- Telemetry ----
VOID_LOG_LEVEL=warn
VOID_METRICS_ENABLED=false
VOID_PROMETHEUS_PORT=9090

# ---- Domain / TLS (optional) ----
VOID_DOMAIN=null.os
VOID_ACME_EMAIL=void@null.os
VOID_TLS_ENABLED=false

# ---- Docker ----
COMPOSE_PROJECT_NAME=void
DOCKER_BUILDKIT=1
