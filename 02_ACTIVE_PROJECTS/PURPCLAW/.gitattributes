# Enforce LF line endings for all text files
# Prevents CRLF→LF "phantom diff" noise in git diff
* text=auto

# Explicit file types that are always text
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.so    binary
*.node  binary
