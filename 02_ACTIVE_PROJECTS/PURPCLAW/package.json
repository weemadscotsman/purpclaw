{
  "name": "purpclaw",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "description": "Local-first AI organisation runtime with Council Mode, Studio ecology, workflow registry, memory, and governed self-evolution.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding",
    "mcp",
    "openai",
    "gemini",
    "ollama",
    "anthropic",
    "multi-agent"
  ],
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weemadscotsman/purpclaw.git"
  },
  "homepage": "https://purpclaw.dev",
  "license": "MIT",
  "private": false,
  "bin": {
    "purpclaw": "bin/purpclaw.js"
  },
  "files": [
    "bin/",
    "lib/",
    "app/",
    "components/",
    "public/",
    "config/",
    "scripts/",
    "service_registry.js",
    "ecosystem.config.js",
    "unified_api.js",
    "orchestrator.js",
    "agent_tower.js",
    "boot.js",
    "purpclaw.js",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "next dev -p 3030 -H 127.0.0.1",
    "dev:cc": "pnpm --filter @purpclaw/companion-chorus start",
    "build": "next build",
    "start": "next start",
    "cli": "node bin/purpclaw.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 list",
    "docs:check": "node scripts/validate-docs.js",
    "docs:gate": "node scripts/docs-gate.js",
    "parity:check": "node scripts/parity-authority-check.js",
    "audit:runtime-evidence": "node scripts/verify-unified-runtime-audit.js --write",
    "test:cross-surface-session": "node scripts/test-cross-surface-session.js",
    "test:cross-surface-session:e2e": "node scripts/test-cross-surface-session-e2e.js",
  "version:status": "node scripts/manifest.js status",
  "version:diff": "node scripts/manifest.js diff",
  "stamp": "node scripts/manifest.js stamp",
  "sync:agents": "node scripts/sync-agents.js",
  "sync:registry": "node scripts/sync-registry.js",
  "drift": "node lib/drift-watcher.js",
  "drift:fix": "node lib/drift-watcher.js --fix",
  "drift:watch": "node lib/drift-watcher.js --watch --fix --interval=60",
  "drift:json": "node lib/drift-watcher.js --json",
  "weather": "node lib/weatherman.js",
  "oracle": "node lib/oracle.js",
    "lint": "eslint .",
    "verify:hivemind": "node scripts/verify-hivemind.js",
    "verify:hivemind:rank1": "node scripts/verify-hivemind.js --rank=1",
    "clean": "next clean",
    "smoke": "python scripts/smoke_all.py",
    "smoke:save": "python scripts/smoke_all.py --save /tmp/purpclaw_smoke.json"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@vscode/ripgrep": "^1.18.0",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.21",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cli-spinners": "^3.4.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "gradient-string": "^3.0.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.38.0",
    "next": "^15.4.9",
    "playwright": "^1.52.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-force-graph-3d": "^1.29.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "main": "bin/purpclaw.js"
}
