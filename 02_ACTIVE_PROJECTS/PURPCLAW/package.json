{
  "name": "purpclaw",
  "version": "0.1.7",
  "description": "Open-source coding-agent CLI. Terminal-first, multi-agent, self-improving. Supports OpenAI, Anthropic, Gemini, Ollama, and 13 more providers.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding",
    "mcp",
    "openai",
    "gemini",
    "ollama",
    "anthropic",
    "multi-agent"
  ],
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weemadscotsman/purpclaw.git"
  },
  "homepage": "https://purpclaw.dev",
  "license": "MIT",
  "private": false,
  "bin": {
    "purpclaw": "bin/purpclaw.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "registry/",
    "apps/extensions/",
    "service_registry.js",
    "ecosystem.config.js",
    "unified_api.js",
    "orchestrator.js",
    "agent_tower.js",
    "README.md",
    "LICENSE",
    ".env.example",
    "!**/node_modules/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.exe",
    "!**/*.bak",
    "!lib/control/native-control/",
    "!**/apply-patch.debug.js",
    "!**/skills.js.debug",
    "!lib/reports/",
    "!**/*.test.js",
    "!lib/__tests__/",
    "!lib/harness/__tests__/",
    "!lib/goop-playground/*.jsonl",
    "!apps/extensions/**/marketing/",
    "!lib/AGENT.md",
    "!lib/STANDARDS.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "node bin/purpclaw.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 list",
    "lint": "eslint .",
    "clean": "next clean",
    "test": "node --test tests/cli/test_cli.js tests/cli/test_update.js tests/steering/test-live-turn.js tests/steering/test-s-modules.js tests/tool-bridge/test-bridge.js tests/update/update-contract.test.js",
    "acceptance": "node scripts/acceptance/run.mjs"
  },
