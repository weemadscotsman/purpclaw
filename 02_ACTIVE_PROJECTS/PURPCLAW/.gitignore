# Dependencies — only root is managed
node_modules/

# pnpm workspace store
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Environment
.env
.env.local
.env.*.local
.env.production

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Lockfiles (only root lockfile is canonical)
# Child package lockfiles are NOT committed for workspace packages
apps/*/package-lock.json
packages/*/package-lock.json
tools/*/package-lock.json

# Build artifacts
*.tsbuildinfo
.next/
.cache/

# var/ is generated and transient runtime state — logs, caches, session data,
# incident artifacts, scratch. The directory skeleton is tracked via .gitkeep so
# the layout is reproducible; the contents never are.
/var/**
!/var/**/
!/var/**/.gitkeep

# Vendored third-party reference material. Kept on disk for reference, kept out
# of our history — 718 files of another project's docs is not our source. The
# PROVENANCE.md beside it IS tracked, so the origin stays recorded.
/research/references/everything-claude-code/*
!/research/references/everything-claude-code/PROVENANCE.md

# Secrets must never be tracked. keys.env was swept into a docs commit by a
# broad "git add -- docs" during the archive move; untracked immediately.
**/keys.env
**/*.env
!**/*.example.env

# .purpclaw/ is runtime state: sessions, credentials, databases, caches.
# It is NOT gitignored by default and six docs under it are deliberately
# tracked, so state confinement moved credentials into a directory git was
# watching. Ignore the contents, keep the tracked briefs.
/.purpclaw/*
!/.purpclaw/CAMPAIGN_STATE.md
!/.purpclaw/COWORK_TODO.md
!/.purpclaw/P0A_BUILDER_BRIEF.md
!/.purpclaw/P0B_BUILDER_BRIEF.md
!/.purpclaw/P0C_BUILDER_BRIEF.md
!/.purpclaw/workspaces.json
